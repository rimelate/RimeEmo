.rimeemo-root {
    padding: 10px;
}

.main-scroll {
    flex-grow: 1;
}

.title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.section {
    margin-bottom: 10px;
    padding: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #3f3f3f;
    border-right-color: #3f3f3f;
    border-top-color: #3f3f3f;
    border-bottom-color: #3f3f3f;
}

.section-title {
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.muted {
    color: #a8a8a8;
    margin-top: 3px;
    margin-bottom: 3px;
}

.messages {
    margin-bottom: 6px;
}

.message-info {
    white-space: normal;
    padding: 4px;
    margin-top: 2px;
    margin-bottom: 2px;
    background-color: rgba(70, 100, 130, 0.25);
}

.message-warning {
    white-space: normal;
    padding: 4px;
    margin-top: 2px;
    margin-bottom: 2px;
    background-color: rgba(160, 120, 40, 0.28);
}

.message-error {
    white-space: normal;
    padding: 4px;
    margin-top: 2px;
    margin-bottom: 2px;
    background-color: rgba(160, 50, 50, 0.28);
}

.slot-list {
    height: 280px;
    margin-top: 4px;
}

.snapshot-list {
    height: 180px;
    margin-top: 4px;
}

.log-list {
    height: 260px;
    margin-top: 4px;
}

.slot-row, .log-row, .snapshot-row {
    padding: 5px;
    border-bottom-width: 1px;
    border-bottom-color: #343434;
}

.row-title {
    -unity-font-style: bold;
}

.row-subtitle {
    color: #b5b5b5;
    white-space: normal;
}

.button-row {
    flex-direction: row;
}

.button-row Button {
    margin-right: 6px;
}



